# ==============================================================================
# EventSense (Jashn) Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Database: SQLite local file (Zero cost, no external server required)
DATABASE_URL="file:./dev.db"

# Google Gemini Free Tier API Key (Get free key at: https://aistudio.google.com/)
# Note: If left blank or quota exhausted, EventSense automatically operates
# in "Offline Mode" with rich curated celebration templates.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model Identifier (Default free tier model)
GEMINI_MODEL="gemini-1.5-flash"

# Node Environment
NODE_ENV="development"

# App URL for absolute links and share tokens
NEXT_PUBLIC_APP_URL="http://localhost:3000"
